# ── Données : 62 Go, reconstituées par les scripts d'ingestion ──────────────────
#
# Rien de `data/` n'entre dans le dépôt. Les sources sont publiques — Copernicus ADS/CDS,
# LCSQA, IGN, data.gouv.fr — et chaque script d'ingestion sait les retélécharger. Ce qui
# doit être versionné, c'est la **requête** qui produit la donnée, pas la donnée.
data/

# ── Sorties volumineuses : régénérables par les scripts qui les écrivent ────────
#
# `reports/` contient 1,2 Go dont 300 Mo pour un seul CSV de prédictions. Les tableaux de
# résultats (quelques kilooctets) sont versionnés ; les tables de prédictions ligne à ligne
# ne le sont pas — elles se recalculent, et leur diff n'a aucun sens.
reports/mos_*.csv
reports/queue_predictions_*.csv
reports/*_predictions.csv
reports/log_*.txt
reports/optuna/
reports/figures/*.html

# Journaux et traces d'exécution
*.log
nohup.out

# ── Artefacts partiels : par construction jamais complets ──────────────────────
#
# Le projet écrit sous un nom provisoire puis renomme. Un `.partiel` qui traîne signale un
# lot interrompu — il ne doit ni être versionné ni être confondu avec un artefact valide.
*.partiel
*.parquet.partiel

# ── Sauvegardes de sécurité avant un lot destructif ─────────────────────────────
#
# `lot_ablation.sh` réécrit `methode_maximale_<P>_h2.csv` en place ; la copie `.avant_ablation`
# est le filet local, sur un disque qui a déjà perdu des écritures en silence. Elle n'a rien
# à faire dans git : son contenu EST le fichier suivi, à l'octet près — vérifié sur les
# quatre polluants. Versionner une copie identique de ce que git porte déjà ne sauve rien
# et rend le diff illisible.
*.avant_ablation

# ── Brouillons de lot ───────────────────────────────────────────────────────────
#
# Les YAML intermédiaires des 9 lots départementaux et leurs valideurs jetables. Le résultat
# consolidé vit dans `docs/departements/`, qui est suivi ; `tmp/` est l'atelier, pas l'œuvre.
tmp/

# ── Python ──────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# ── Notebooks : sorties non déterministes ──────────────────────────────────────
.ipynb_checkpoints/

# ── Secrets — jamais, sous aucun prétexte ──────────────────────────────────────
.cdsapirc
.adsapirc
*.key
*.pem
.env
secrets.*

# ── Système ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Sorties intermédiaires volumineuses, régénérables ──────────────────────────
#
# Tables ligne à ligne et rendus d'image : plusieurs mégaoctets chacun, aucun diff
# lisible, et reproduits par les scripts qui les nomment.
reports/calendrier_*.csv
reports/heatmap_annuelle_*.csv
reports/figures/rendu/

# ── Matériel de candidature — JAMAIS public ────────────────────────────────────
#
# Le dépôt est destiné à être lu par le destinataire de la candidature. Y publier la
# lettre, les notes d'orateur, la planification et le scan de leur propre offre
# transformerait une sincérité en tactique — et exposerait des coordonnées personnelles.
#
# Ces fichiers restent sur le disque, hors suivi de version.
docs/LETTRE_ATMO_OCCITANIE.md
docs/SOUTENANCE_ATMO_6_DIAPOSITIVES.md
docs/NOTE_ATMO_OCCITANIE.md
docs/ROADMAP.md
ROADMAP_*.md
reports/offre_atmo_occitanie.png
reports/VERIFICATION_CANDIDATURE.md
reports/verification_candidature.csv
scripts/verifier_dossier_candidature.py
# Il nomme la fiche d'oral et le fichier de vérification dans son propre code : le publier
# révélerait l'existence des pièces que ce bloc retire, par leurs chemins exacts.
scripts/tracer_chiffres_soutenance.py

# ── Artefacts régénérables — 137 Mo mesurés le 04/08 ─────────────────────────
# Les pages HTML se reconstruisent par `scripts/pages_soutenance.py`,
# `pages_regions.py` et `page_champ_region.py` depuis les parquets de prédictions.
# Les versionner alourdirait l'historique de 137 Mo pour zéro information : le code
# qui les produit est déjà suivi, et lui seul mérite de l'être.
reports/html/
proto/
data/processed/champs/

# ── Matériel de candidature et correspondance : JAMAIS publié ────────────────
# Le courriel de demande d'archive PREV'AIR portait l'adresse personnelle ET le
# numéro de téléphone dans un dépôt public — constaté le 04/08. Le dépôt sert à
# montrer le travail, pas à exposer des coordonnées.
docs/MAIL_*.md
docs/LETTRE_*.md
docs/NOTE_ATMO*.md
docs/SOUTENANCE_*.md
ROADMAP_*.md

# Sorties de nohup des lots — le journal utile est le .log
logs/*.sortie

# ── Réunions simulées ───────────────────────────────────────────────────────────
#
# `reunions/` contient des simulations d'ateliers entre partenaires : un exercice de travail
# pour faire remonter des besoins métier. Chaque fichier porte un bandeau disant qu'aucune de
# ces personnes n'existe et qu'aucun de ces propos n'a été tenu. Mais ces textes attribuent
# des positions à des organisations RÉELLES ET NOMMÉES (ARS, DREAL, métropoles, INERIS…), et
# sur un dépôt public un lecteur pressé peut les prendre pour des comptes rendus.
# Ils restent donc locaux, comme NOTE / LETTRE / SOUTENANCE ci-dessus. Décision réversible
# en retirant cette ligne — mais elle se prend en connaissance de cause, pas par défaut.
reunions/

# Repère de campagne : datation LOCALE d'un lot régénérant, jamais partagée.
# Le committer ferait croire à un clone que la campagne a déjà eu lieu.
logs/.*_campagne
